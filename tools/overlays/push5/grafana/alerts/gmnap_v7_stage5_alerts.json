{
  "apiVersion": 1,
  "groups": [
    {
      "name": "gmnap-v7-stage5",
      "interval": "1m",
      "rules": [
        {
          "uid": "gmnap-stage5-collisions-spike",
          "title": "Stage 5 collisions spike",
          "condition": "A",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "prometheus",
              "model": {
                "expr": "increase(gmnap_write_diff_changed_entries[10m]) > 10000",
                "interval": "1m"
              }
            }
          ],
          "for": "0m",
          "labels": {
            "severity": "warning",
            "service": "gmnap"
          },
          "annotations": {
            "summary": "Potential duplicate explosion detected (proxy via changed entries spike)."
          }
        }
      ]
    }
  ]
}