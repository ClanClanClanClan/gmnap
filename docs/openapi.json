  "paths": {
    "/": {
      "get": {
        "operationId": "serve_index__get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Serve Index"
      }
    },
    "/api/v1/lineage/{global_id}": {
      "get": {
        "description": "Query academic genealogy lineage for a GlobalID or name.\n\n``direction=ancestors`` (default) walks ``advisor-of-me``;\n``direction=descendants`` walks ``student-of-me`` so a query\nfor \"Hilbert\" returns his ~76 known students rather than his\n2 advisors.",
        "operationId": "get_lineage_api_v1_lineage__global_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "global_id",
            "required": true,
            "schema": {
              "title": "Global Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "depth",
            "required": false,
            "schema": {
              "default": 3,
              "maximum": 10,
              "minimum": 1,
              "title": "Depth",
              "type": "integer"
            }
          },
          {
            "description": "ancestors = walk up the advisor chain; descendants = walk down the student chain",
            "in": "query",
            "name": "direction",
            "required": false,
            "schema": {
              "default": "ancestors",
              "description": "ancestors = walk up the advisor chain; descendants = walk down the student chain",
              "pattern": "^(ancestors|descendants)$",
              "title": "Direction",
              "type": "string"
            }
          },
          {
            "description": "Output format: json/dot/svg",
            "in": "query",
            "name": "format",
            "required": false,
            "schema": {
              "default": "json",
              "description": "Output format: json/dot/svg",
              "title": "Format",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Lineage"
      }
    },
