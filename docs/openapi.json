    "/metrics": {
      "get": {
        "description": "Prometheus-compatible metrics endpoint.\n\nDefense-in-depth: nginx restricts /metrics to internal CIDRs\n(10.x, 172.16-31.x, 192.168.x, 127.0.0.1) at the edge, but\nwe ALSO check at the app layer because in a k8s pod or a\nmisconfigured deploy the client_ip is the load-balancer's\naddress \u2014 nginx's IP allowlist alone isn't enough.\n\nAuth path: either (a) the request is from a localhost /\nprivate-CIDR client (typical scrape from a local Prometheus),\nOR (b) it presents a Bearer token from GMNAP_API_TOKENS\n(typical scrape from a paid-tier monitoring service). Set\nGMNAP_METRICS_REQUIRE_AUTH=0 to disable both checks for\nsingle-tenant deploys behind a trusted reverse proxy.",
        "operationId": "metrics_metrics_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Metrics"
      }
    },
