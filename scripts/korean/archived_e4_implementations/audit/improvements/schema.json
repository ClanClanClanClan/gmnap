{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gmnap.org/schemas/korean-improvement-log.json",
  "title": "Korean Regional Processor Improvement Log Schema",
  "description": "Schema for systematic improvement framework audit logs (§1.6)",
  "type": "object",
  "required": [
    "timestamp",
    "framework_version", 
    "git_commit",
    "mapping_sha256_before",
    "mapping_sha256_after",
    "category",
    "rationale",
    "mappings_added",
    "mappings",
    "baseline_performance",
    "final_performance"
  ],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 Zulu timestamp of improvement"
    },
    "framework_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "Systematic Improvement Framework version"
    },
    "git_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{7,40}$",
      "description": "Git commit hash for reproducibility"
    },
    "mapping_sha256_before": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 of mapping file before changes"
    },
    "mapping_sha256_after": {
      "type": "string", 
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 of mapping file after changes"
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Systematic category of mappings added"
    },
    "rationale": {
      "type": "string",
      "minLength": 10,
      "maxLength": 1000,
      "description": "Explanation for why mappings were added"
    },
    "mappings_added": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000,
      "description": "Number of mappings added in this improvement"
    },
    "mappings": {
      "type": "array",
      "items": {
        "type": "array",
        "items": [
          {"type": "string", "description": "Hangul"},
          {"type": "string", "description": "Roman"},
          {"type": "string", "pattern": "^-?\\d+\\.\\d{1,4}$", "description": "Weight"}
        ],
        "minItems": 3,
        "maxItems": 3
      },
      "minItems": 1,
      "maxItems": 1000
    },
    "baseline_performance": {
      "$ref": "#/definitions/performance_results"
    },
    "final_performance": {
      "$ref": "#/definitions/performance_results"
    },
    "statistical_analysis": {
      "type": "object",
      "properties": {
        "math_dataset": {"$ref": "#/definitions/statistical_metrics"},
        "diverse_dataset": {"$ref": "#/definitions/statistical_metrics"},
        "independent_dataset": {"$ref": "#/definitions/statistical_metrics"}
      }
    },
    "improvement_summary": {
      "type": "object",
      "properties": {
        "math_dataset": {"$ref": "#/definitions/improvement_metrics"},
        "diverse_dataset": {"$ref": "#/definitions/improvement_metrics"},
        "independent_dataset": {"$ref": "#/definitions/improvement_metrics"}
      }
    }
  },
  "definitions": {
    "performance_results": {
      "type": "object",
      "properties": {
        "math_dataset": {"$ref": "#/definitions/dataset_performance"},
        "diverse_dataset": {"$ref": "#/definitions/dataset_performance"},
        "independent_dataset": {"$ref": "#/definitions/dataset_performance"}
      }
    },
    "dataset_performance": {
      "type": "object",
      "oneOf": [
        {
          "required": ["success", "total", "accuracy"],
          "properties": {
            "success": {"type": "integer", "minimum": 0},
            "total": {"type": "integer", "minimum": 1},
            "accuracy": {"type": "number", "minimum": 0, "maximum": 100},
            "parsed_line": {"type": "string"}
          }
        },
        {
          "required": ["error"],
          "properties": {
            "error": {"type": "string"},
            "debug_output": {"type": "string"}
          }
        }
      ]
    },
    "statistical_metrics": {
      "type": "object",
      "properties": {
        "wilson_lower_bound": {"type": "number", "minimum": 0, "maximum": 100},
        "wilson_upper_bound": {"type": "number", "minimum": 0, "maximum": 100},
        "standard_error": {"type": "number", "minimum": 0}
      }
    },
    "improvement_metrics": {
      "type": "object",
      "properties": {
        "baseline": {"type": "number", "minimum": 0, "maximum": 100},
        "final": {"type": "number", "minimum": 0, "maximum": 100},
        "change": {"type": "number"},
        "is_statistically_significant": {"type": "boolean"},
        "standard_error": {"type": "number", "minimum": 0}
      }
    }
  },
  "additionalProperties": false
}