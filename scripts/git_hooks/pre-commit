#!/usr/bin/env bash
# GMNAP V7 Pre-commit validation
# Uses manager_optimized (37 regions), skips if dependencies unavailable

echo "🔬 GMNAP V7 Pre-commit Validation"

cd "$(git rev-parse --show-toplevel)"

# Use Python 3.12 framework build if available (has project deps installed)
if command -v /Library/Frameworks/Python.framework/Versions/3.12/bin/python3 &>/dev/null; then
    PYTHON="/Library/Frameworks/Python.framework/Versions/3.12/bin/python3"
elif command -v python3.12 &>/dev/null; then
    PYTHON="python3.12"
else
    PYTHON="python3"
fi

# Allow override via env
PYTHON="${GMNAP_PYTHON:-$PYTHON}"

# Test 1: Verify E4 Korea integration works
echo "Testing E4 Korea integration..."
$PYTHON -c "
import sys, os
sys.path.insert(0, '.')
os.environ.setdefault('GMNAP_NO_NETWORK', '1')

try:
    from src.regions.manager_optimized import RegionManager
    manager = RegionManager()
    manager._ensure_regions_loaded()

    if 'E4' not in manager._regions:
        print('❌ E4 Korea region not loaded')
        exit(1)

    test_entry = {'CanonicalLatin': 'Kim Jong-Un'}
    processor = manager._regions['E4']
    processor.clean(test_entry)
    processor.augment(test_entry)
    processor.validate(test_entry)

    print('✅ E4 Korea integration working')

except ImportError as e:
    print(f'⚠️  Skipping E4 test (missing dependency: {e})')

except Exception as e:
    print(f'❌ E4 integration failed: {e}')
    exit(1)
"

if [ $? -ne 0 ]; then
    echo "❌ Pre-commit validation failed"
    exit 1
fi

# Test 2: Verify performance optimization is deployed
echo "Testing performance optimization..."
$PYTHON -c "
import sys, os, time
sys.path.insert(0, '.')
os.environ.setdefault('GMNAP_NO_NETWORK', '1')

try:
    from src.regions.manager_optimized import RegionManager
    manager = RegionManager()

    start = time.time()
    manager._ensure_regions_loaded()
    load_time = time.time() - start

    region_count = len(manager._regions)
    if region_count < 37:
        print(f'⚠️ Only {region_count}/37 regions loaded')
    elif load_time > 2.0:
        print(f'⚠️ Region loading slow ({load_time:.2f}s)')
    else:
        print(f'✅ Performance OK ({load_time:.2f}s, {region_count} regions)')

except ImportError as e:
    print(f'⚠️  Skipping perf test (missing dependency: {e})')

except Exception as e:
    print(f'❌ Performance test failed: {e}')
    exit(1)
"

if [ $? -ne 0 ]; then
    echo "❌ Performance validation failed"
    exit 1
fi

# Test 3: Repo-invariant audit (--fast mode skips B2 + I1, ~2.5s total)
# Catches the kind of drift the audit was built for — references to
# deleted files, JSON/YAML parse errors, doc-vs-data numerical
# claims, test-module shadowing — before they reach CI.
# Bypass with 'git commit --no-verify' only if you've consciously
# decided the audit false-positives on your specific change.
echo "Running repo-invariant audit (fast mode)..."
PYTHONPATH=. $PYTHON tools/audit_repo.py --fast
if [ $? -ne 0 ]; then
    echo "❌ audit-repo failed — fix the issue or use 'git commit --no-verify' to bypass"
    exit 1
fi

echo "✅ All pre-commit validations passed!"
