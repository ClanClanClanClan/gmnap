# GMNAP Comprehensive Makefile
# Production-ready build, test, and deployment automation

.PHONY: help install test test-unit test-integration test-hardcore test-performance test-property test-quality test-all test-quick test-coverage clean lint format type-check security-scan build docs deploy

# Default target
help:
	@echo "GMNAP - Global Mathematician Name Authority Project"
	@echo "=================================================="
	@echo ""
	@echo "Available targets:"
	@echo "  install          - Install dependencies"
	@echo "  test             - Run all tests"
	@echo "  test-unit        - Run unit tests only"
	@echo "  test-integration - Run integration tests only"
	@echo "  test-hardcore    - Run hardcore tests only"
	@echo "  test-performance - Run performance tests only"
	@echo "  test-property    - Run property-based tests only"
	@echo "  test-quality     - Run quality gate tests only"
	@echo "  test-quick       - Run quick test subset"
	@echo "  test-coverage    - Run tests with coverage report"
	@echo "  lint             - Run code linting"
	@echo "  format           - Format code"
	@echo "  type-check       - Run type checking"
	@echo "  security-scan    - Run security scanning"
	@echo "  build            - Build distribution packages"
	@echo "  docs             - Generate documentation"
	@echo "  clean            - Clean build artifacts"
	@echo "  deploy           - Deploy to production"
	@echo ""
	@echo "Quality Gates:"
	@echo "  - Memory limit: ≤2GB RAM"
	@echo "  - Processing speed: ≤0.1ms per GlobalID"
	@echo "  - Accuracy: ≥95% script detection, ≥90% region detection"
	@echo "  - Reliability: 100% invariant compliance"
	@echo ""
	@echo "Version: $(VERSION)"

# Default Python interpreter
PYTHON ?= python3
PIP ?= pip3
PYTEST ?= pytest

# Directories
SRC_DIR := src
TEST_DIR := tests
DOCS_DIR := docs
BUILD_DIR := build
DIST_DIR := dist

# Version information
VERSION := $(shell $(PYTHON) -c "import sys; sys.path.insert(0, '$(SRC_DIR)'); from core.version import __version__; print(__version__)" 2>/dev/null || echo "unknown")

# Installation
install:
	@echo "Installing GMNAP dependencies..."
	$(PIP) install --upgrade pip setuptools wheel
	$(PIP) install -r requirements.txt
	$(PIP) install -r requirements-dev.txt
	@echo "Installing pre-commit hooks..."
	pre-commit install
	@echo "Installation complete!"

# Test targets
test: test-unit test-integration test-hardcore test-performance test-quality
	@echo "All tests completed!"

test-unit:
	@echo "Running unit tests..."
	$(PYTEST) $(TEST_DIR)/unit -v --tb=short --durations=10
	@echo "Unit tests completed!"

test-integration:
	@echo "Running integration tests..."
	$(PYTEST) $(TEST_DIR)/integration -v --tb=short --durations=10
	@echo "Integration tests completed!"

test-hardcore:
	@echo "Running hardcore tests..."
	$(PYTHON) $(TEST_DIR)/hardcore/test_runner.py
	@echo "Hardcore tests completed!"

test-performance:
	@echo "Running performance tests..."
	$(PYTEST) $(TEST_DIR)/performance -v --tb=short --benchmark-only
	@echo "Performance tests completed!"

test-property:
	@echo "Running property-based tests..."
	$(PYTEST) $(TEST_DIR)/property -v --tb=short --hypothesis-show-statistics
	@echo "Property-based tests completed!"

test-quality:
	@echo "Running quality gate tests..."
	$(PYTEST) $(TEST_DIR)/quality_gates -v --tb=short
	@echo "Quality gate tests completed!"

test-quick:
	@echo "Running quick test subset..."
	$(PYTHON) $(TEST_DIR)/hardcore/test_runner.py --quick
	@echo "Quick tests completed!"

test-coverage:
	@echo "Running tests with coverage..."
	$(PYTEST) $(TEST_DIR)/unit $(TEST_DIR)/integration \
		--cov=$(SRC_DIR) \
		--cov-report=html:$(BUILD_DIR)/coverage \
		--cov-report=term-missing \
		--cov-report=xml:$(BUILD_DIR)/coverage.xml \
		--cov-fail-under=85
	@echo "Coverage report generated in $(BUILD_DIR)/coverage/"

test-stress:
	@echo "Running stress tests (long-running)..."
	$(PYTEST) $(TEST_DIR)/hardcore/test_stress_endurance.py -v -s -m slow
	@echo "Stress tests completed!"

# Code quality targets
lint:
	@echo "Running ruff..."
	ruff check $(SRC_DIR)/ $(TEST_DIR)/
	@echo "Running black check..."
	black --check --diff $(SRC_DIR)/ $(TEST_DIR)/
	@echo "Running isort check..."
	isort --check-only --diff $(SRC_DIR)/ $(TEST_DIR)/
	@echo "Running codespell..."
	codespell $(SRC_DIR)/ $(TEST_DIR)/ $(DOCS_DIR)/ README.md
	@echo "Running yamllint..."
	yamllint .github/workflows/ $(DOCS_DIR)/

format:
	@echo "Formatting with black..."
	black $(SRC_DIR)/ $(TEST_DIR)/
	@echo "Sorting imports with isort..."
	isort $(SRC_DIR)/ $(TEST_DIR)/
	@echo "Fixing with ruff..."
	ruff check --fix $(SRC_DIR)/ $(TEST_DIR)/

security:
	@echo "Running bandit security scan..."
	bandit -r $(SRC_DIR)/ -f json -o bandit-report.json || true
	@echo "Running safety check..."
	safety check || true
	@echo "Security scan complete. Check bandit-report.json for details."

typecheck:
	$(PIP) install mypy types-requests
	mypy $(SRC_DIR)/ || true

# Pipeline targets
quick:
	PIPELINE_MODE=quick $(PYTHON) -m $(SRC_DIR).core.pipeline

full:
	PIPELINE_MODE=full $(PYTHON) -m $(SRC_DIR).core.pipeline

extreme:
	PIPELINE_MODE=extreme $(PYTHON) -m $(SRC_DIR).core.pipeline --force-extreme

# Docker targets
docker-build:
	docker build -t gmnap:latest .

docker-run:
	docker-compose up gmnap

docker-dev:
	docker-compose up gmnap-dev

docker-test:
	docker-compose run --rm gmnap python -m pytest tests/ -v

# Maintenance targets
clean:
	@echo "Cleaning up generated files..."
	find . -type f -name "*.pyc" -delete
	find . -type d -name "__pycache__" -exec rm -rf {} + 2>/dev/null || true
	find . -type d -name "*.egg-info" -exec rm -rf {} + 2>/dev/null || true
	rm -rf .pytest_cache/
	rm -rf .coverage
	rm -rf htmlcov/
	rm -rf dist/
	rm -rf build/
	rm -f bandit-report.json
	rm -f safety-report.json
	rm -f coverage.xml
	@echo "Cleanup complete!"

clean-cache:
	@echo "Cleaning cache directories..."
	rm -rf $(CACHE_DIR)/*
	rm -rf .hypothesis/
	mkdir -p $(CACHE_DIR)/gs $(CACHE_DIR)/bad_json
	@echo "Cache cleanup complete!"

clean-all: clean clean-cache
	rm -rf venv/
	rm -f lid.176.bin

update-deps:
	$(PIP) install --upgrade pip
	$(PIP) install --upgrade -r requirements.txt
	$(PIP) freeze > requirements-frozen.txt

# Development helpers
dev-setup: install install-hooks
	@echo "Development environment setup complete!"

ci-setup:
	sudo apt-get update
	sudo apt-get install -y libicu-dev zstd duckdb sqlite3

check-setup:
	@echo "Checking development setup..."
	@$(PYTHON) --version
	@$(PYTHON) -c "import sys; print(f'Python path: {sys.executable}')"
	@$(PYTHON) -c "from $(SRC_DIR).core.unicode_handler import UnicodeNormalizer; print('Unicode handler: OK')"
	@$(PYTHON) -c "from $(SRC_DIR).validation.schema import SchemaValidator; print('Schema validator: OK')"
	@$(PYTHON) -c "from $(SRC_DIR).utils.database import DatabaseManager; print('Database manager: OK')"
	@if [ -f lid.176.bin ]; then echo "FastText model: OK"; else echo "FastText model: MISSING"; fi
	@echo "Setup check complete!"

# Benchmarking
benchmark:
	$(PYTHON) -m pytest $(TEST_DIR)/memory/ -v --tb=short --durations=0

profile:
	$(PYTHON) -m cProfile -o profile.stats -m $(SRC_DIR).core.pipeline
	$(PYTHON) -c "import pstats; p = pstats.Stats('profile.stats'); p.sort_stats('cumulative').print_stats(20)"

# Documentation
docs-validate:
	$(PYTHON) -c "import json, jsonschema; schema = json.load(open('$(DOCS_DIR)/schema.json')); jsonschema.Draft7Validator.check_schema(schema); print('Schema valid')"

# Release helpers
version:
	@$(PYTHON) -c "from $(SRC_DIR) import __version__; print(__version__)"

check-version:
	@echo "Checking version consistency..."
	@$(PYTHON) -c "
	import json, re
	from pathlib import Path
	from $(SRC_DIR) import __version__
	
	# Check schema version
	schema = json.load(open('$(DOCS_DIR)/schema.json'))
	schema_version = schema.get('\$$id', '').split('/')[-1].replace('.json', '')
	
	# Check spec version
	spec_content = Path('$(DOCS_DIR)/specs v6.md').read_text()
	spec_match = re.search(r'Version (\d+)', spec_content)
	spec_version = spec_match.group(1) if spec_match else 'unknown'
	
	print(f'Code version: {__version__}')
	print(f'Schema version: {schema_version}')
	print(f'Spec version: {spec_version}')
	
	if not (__version__.startswith(spec_version) and schema_version.startswith('v' + spec_version)):
		print('ERROR: Version mismatch detected!')
		exit(1)
	print('Version consistency: OK')
	"