# Pytest cache was accidentally committed at the repo root-level
# tests/ subdirectory. Untracked in commit <next>. The root-level
# .pytest_cache/ already ignores its own; this adds the nested path.
tests/.pytest_cache/

# Per-run browser screenshots from tools/browser_smoke.py. The
# curated demo shots live under docs/screenshots/ (no nested dir).
docs/screenshots/browser_audit/

# Generated by tools/browser_smoke.py — uploaded as CI artifact, not committed
docs/browser_audit.md

# Per-run output of tools/eval_authority.py — only commit when produced
# from a real OFFLINE=0 live run via 'make eval-authority'. Smoke-test
# results from --allow-offline are explicitly excluded.
docs/authority_quality.json

# ── R41 org cleanup: runtime/generated dirs + scratch dumps that were
#    polluting `git status` (verified NOT previously ignored via
#    `git check-ignore`). Some have tracked files that get `git rm --cached`
#    in the same cleanup pass; ignoring them here keeps them out once
#    untracked. The root-level `archive/` is an untracked personal stash.
coverage.xml
/out/
/snapshots/
/work/
/analysis/
/cache_thread_*/
/cache_security_test/
/test_results/
/ultracheck_*.json
/ultrafix_*.json
/archive/
config/*.bin
# SQLite WAL/SHM sidecars from SQLiteAnalytics / test runs
*.db-shm
*.db-wal
