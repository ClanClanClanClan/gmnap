# GMNAP Docker Compose Environment Variables
# Copy to .env and customize for production

# Database
MEMGRAPH_PASSWORD=change_me_in_production

# Monitoring
GF_SECURITY_ADMIN_PASSWORD=change_me_in_production

# API
GMNAP_API_TOKENS=

# Authority sources (tier 2)
SCOPUS_API_KEY=
DIMENSIONS_API_KEY=

# CORS (comma-separated origins, default: * for all)
# CORS_ALLOWED_ORIGINS=https://myapp.example.com,http://localhost:3000

# Pipeline
OFFLINE=1                    # Blocks tier-1+ authority sources (HAL, GND, Wikidata, zbMATH, OAI)
PIPELINE_MODE=quick          # quick (tier-0 only) | full (tier-0+1) | extreme (all tiers)
# GMNAP_NO_NETWORK=1        # Uncomment to block ALL HTTP calls (airgapped/CI environments)
# GMNAP_SCHEMA_STRICT=0     # 0=advisory, 1=quarantine, 2=reject
