# GMNAP V7 Environment Configuration
# Copy this to .env and fill in values for your deployment.
# Every variable below is read at process start; restart the
# container / uvicorn worker after changes.

# ── Pipeline Mode ────────────────────────────────────────────
PIPELINE_MODE=quick              # quick/full/extreme
GMNAP_SCHEMA_STRICT=0            # 0=advisory, 1=quarantine, 2=reject
OFFLINE=1                        # 1=cache-only (default), 0=live API calls
GMNAP_NO_NETWORK=1               # Same as OFFLINE=1

# ── API Server ───────────────────────────────────────────────
GMNAP_API_TOKENS=                # Comma-separated Bearer tokens for paid tier
GMNAP_FREE_RPM=60                # Free-tier requests/min (V7 spec §12)
GMNAP_PAID_RPM=10000             # Paid-tier requests/min

# Free-tier proof-of-work gate (V7 spec §12). Default 1 = require
# X-Hashcash 18-bit PoW header on every /api/* request (multi-tenant
# prod). Set 0 for local dev, CI, single-tenant, or behind-the-firewall
# deploys. `gmnap serve --no-hashcash` sets this for you.
GMNAP_REQUIRE_HASHCASH=1

# CORS allowlist — comma-separated. NO localhost fallback in prod;
# the server logs a warning if unset.
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# /metrics endpoint requires either a private-CIDR client (10/8,
# 172.16-31/16, 192.168/16, 127.0.0.1) OR a paid Bearer token by
# default. Set 0 to allow public scraping (single-tenant deploys
# behind a trusted reverse proxy).
GMNAP_METRICS_REQUIRE_AUTH=1

# ── Logging ──────────────────────────────────────────────────
GMNAP_LOG_FORMAT=text            # text (human) or json (Loki/Datadog/etc.)
GMNAP_LOG_LEVEL=INFO             # DEBUG/INFO/WARNING/ERROR/CRITICAL

# ── Graph Database (optional) ────────────────────────────────
MEMGRAPH_HOST=localhost
MEMGRAPH_PORT=7687
MEMGRAPH_USER=gmnap
# Hardcoded password was committed to docker-compose.yml prior to
# round 34. Override here for any deploy that isn't local-dev.
MEMGRAPH_PASSWORD=v7_lineage_local_dev_only
MEMGRAPH_BOLT=bolt://localhost:7687

# ── Authority Sources (optional, for OFFLINE=0) ──────────────
# Tier 0 (free, no key needed): OpenAlex, Crossref, ORCID
# Tier 1 (free, some need keys):
# SCOPUS_API_KEY=                # Free at dev.elsevier.com
# DIMENSIONS_API_KEY=            # Free at app.dimensions.ai

# ── Cost guard ───────────────────────────────────────────────
# CI's cost-guard job fails the build if monthly spend exceeds
# this CHF amount. Overrides the default 120 CHF / month limit.
COST_GUARD_LIMIT_CHF=120
# Override the costs file path (default cache/api_costs.json).
# GMNAP_COSTS_PATH=cache/api_costs.json

# ── GDPR ─────────────────────────────────────────────────────
# GMNAP_DROP_PERSONAL=0          # 1=replace personal data with ShadowNodes

# ── Extreme Mode (tier-3 sources) ────────────────────────────
# YES_I_ACCEPT_GS_TOS=yes        # Required for Google Scholar scraping
