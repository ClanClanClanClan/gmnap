#!/bin/bash
# Git pre-receive hook for Korean Regional Processor
# Implements server-side validation to prevent broken commits (§3.1)

set -e

echo "=== Korean Regional Processor - Server-side Validation ==="

# Check if mapping file is modified
if git diff --name-only HEAD~1 HEAD | grep -q "resources/rr_syllable_map.csv"; then
    echo "Mapping file modified - running systematic validation..."
    
    # Run validation framework
    if ! python3 scripts/systematic_improvement_framework_v2.py validate; then
        echo "❌ SIF validation failed - rejecting push"
        echo "All mapping changes must pass comprehensive validation"
        exit 1
    fi
    
    echo "✅ Mapping file validation passed"
fi

# Check for direct CSV edits bypassing framework
if git log --oneline -1 | grep -qv "SIF\|systematic"; then
    if git diff --name-only HEAD~1 HEAD | grep -q "resources/rr_syllable_map.csv"; then
        echo "⚠️  Warning: Mapping file changed without SIF commit message"
        echo "Please use systematic_improvement_framework_v2.py for changes"
    fi
fi

echo "✅ Server-side validation complete"