#!/bin/bash
# Server-side Git hook for Systematic Improvement Framework (SIF) validation
# Patch D: Prevents spec-violating commits from entering the repository

set -e

echo "🔍 SIF Pre-receive Hook: Validating systematic improvements..."

# Check if this is a mapping file change
while read oldrev newrev refname; do
    echo "Checking ref: $refname ($oldrev..$newrev)"
    
    # Check if rr_syllable_map.csv was modified
    if git diff --name-only "$oldrev..$newrev" | grep -q "resources/rr_syllable_map.csv"; then
        echo "📋 Mapping file changed - running SIF validation"
        
        # Temporary checkout to validate
        TEMP_DIR=$(mktemp -d)
        cd "$TEMP_DIR"
        git clone "$GIT_DIR" temp_repo
        cd temp_repo
        git checkout "$newrev"
        
        # Run SIF validation
        if python3 scripts/systematic_improvement_framework_v2.py validate; then
            echo "✅ SIF validation passed"
        else
            echo "❌ SIF validation failed - rejecting commit"
            echo "Please ensure systematic improvements maintain performance thresholds"
            rm -rf "$TEMP_DIR"
            exit 1
        fi
        
        # Cleanup
        rm -rf "$TEMP_DIR"
    fi
done

echo "✅ Pre-receive validation complete"
exit 0